{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileLineage",
  "version": "0.3.0",
  "identifier": "io.github.filelineage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文件因果溯源台 · FileLineage",
        "width": 1380,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "FileLineage",
    "copyright": "© 2026 FileLineage. All rights reserved.",
    "category": "Utility",
    "shortDescription": "文件因果溯源台",
    "longDescription": "给每个文件回答三个问题：它从哪来、经过谁的手、现在还有没有用。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
